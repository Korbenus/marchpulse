# Application environment: dev | prod
MP_ENV=dev
MP_LOG_LEVEL=INFO
MP_BASE_URL=http://127.0.0.1:8000
MP_DB_PATH=data/marchepulse.db
# Optional permanent PostgreSQL URL (e.g. Neon.tech free tier) to persist data across Render restarts
MP_DATABASE_URL=
MP_FEED_DIR=data/feed

# Internal admin secret (generate a long random string in production)
MP_ADMIN_SECRET=change-me-admin-secret

# RapidAPI monetization (optional: set the Proxy Secret from RapidAPI Provider Dashboard)
MP_RAPIDAPI_PROXY_SECRET=
MP_RAPIDAPI_LISTING_URL=
# Set to true only if selling directly on your site with legal mentions (Solution B)
MP_DIRECT_BILLING_ENABLED=false

# LemonSqueezy (Merchant of Record - ideal for auto-entreprise)
MP_LEMONSQUEEZY_WEBHOOK_SECRET=
MP_LEMONSQUEEZY_CHECKOUT_URL=

# Stripe (optional alternative or complement to LemonSqueezy)
MP_STRIPE_WEBHOOK_SECRET=
MP_STRIPE_CHECKOUT_URL=

# Email delivery via Resend (free tier: 3000 emails/month)
MP_RESEND_API_KEY=
MP_EMAIL_FROM=MarchePulse <alerts@example.com>

# Pipeline settings
MP_BOAMP_FETCH_LIMIT=50
MP_ENRICH_MAX_PER_RUN=15
